# .env versi desktop (installer Windows) - disalin ke %APPDATA%\GiftTokTok\.env oleh
# launcher saat GiftTokTok pertama kali dibuka. Nilai __PLACEHOLDER__ diisi otomatis.
# File hasil salinan boleh diedit manual (mis. ganti APP_PORT kalau bentrok).

APP_NAME=GiftTokTok
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_PORT=__APP_PORT__
APP_URL=http://127.0.0.1:__APP_PORT__

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# Lokasi database: %APPDATA%\GiftTokTok\database.sqlite (otomatis, lihat config/database.php).
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=10000
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=normal

# File (bukan database) supaya tidak ikut berebut kunci tulis SQLite.
# Lifetime panjang: operator tidak ke-logout di tengah live.
SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
