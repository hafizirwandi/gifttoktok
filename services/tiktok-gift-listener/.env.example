# Salin file ini jadi .env lalu isi dengan nilai dari halaman Admin project
# (bagian "Auto Gift Mode" -> panel info di bawahnya).

TIKTOK_USERNAME=namaakun
PROJECT_LIVE_ID=1
WEBHOOK_URL=http://127.0.0.1:8000/api/webhooks/tiktok-gift
WEBHOOK_SECRET=

# Opsional tapi SANGAT disarankan kalau sering kena error "signing server rate-limit"
# (SignatureRateLimitError / retry-after) - tanpa ini, semua pengguna tiktok-live-connector
# di seluruh dunia berbagi SATU jatah rate-limit anonim yang sama, gampang penuh.
# Daftar API key GRATIS di https://www.eulerstream.com lalu isi di bawah ini.
TIKTOK_SIGN_API_KEY=
